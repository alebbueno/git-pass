+function dismissStartupSplash(): void {
+  const splash = document.querySelector<HTMLElement>("#gitpass-splash");
+  if (!splash) return;
+  if (window.matchMedia("(prefers-reduced-motion: reduce)").matches ||
+      getComputedStyle(splash).visibility === "hidden") {
+    splash.remove();
+    return;
+  }
+  const animation = splash.getAnimations().find((item) =>
+    "animationName" in item && item.animationName === "gp-splash-lifetime");
+  const currentTime = animation?.currentTime;
+  const elapsed = typeof currentTime === "number" ? currentTime : performance.now();
+  const previousInert = app.inert;
+  app.inert = true;
+  window.setTimeout(() => {
+    splash.dataset.exit = "true";
+    window.setTimeout(() => {
+      splash.remove();
+      app.inert = previousInert;
+    }, 240);
+  }, Math.max(0, 1380 - elapsed));
+}
+
 const initial = location.hash.replace("#", "") as ViewId;
 navigate(VIEWS.some((v) => v.id === initial) ? initial : "overview");
+dismissStartupSplash();
